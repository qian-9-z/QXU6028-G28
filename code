# 2. 全局物理常量
# ==============================================================================
KB = 8.617333e-5           # eV / K
NA = 3.816e15              # atoms / cm^2
E_CHARGE = 1.602176634e-19  # C
EMAX = 2.5                 # eV

def fermi(E, EF, T):
    x = np.clip((E - EF) / (KB * T), -60.0, 60.0)
    return 1.0 / (np.exp(x) + 1.0)

# ==============================================================================
# 3. PHASE L1: 前向载流子模型与迁移率修正
# ==============================================================================
print("\n" + "-"*50)
print(">>> [Phase L1] 正在执行载流子积分与迁移率修正...")
print("-"*50)

with open(DATA_DIR / "L1_params.json", "r", encoding="utf-8") as f:
    l1_params = json.load(f)

c_DoS = float(l1_params["c"])
T_L1 = float(l1_params["T"])
EF_op = float(l1_params["EF_op_eV"])
rho_op = float(l1_params.get("rho_ohm_sq", l1_params.get("sheet_resistivity_ohm_sq", 0.0)))

df_l1 = pd.read_csv(DATA_DIR / "L1_data.csv")
ef_col_l1 = [c for c in df_l1.columns if "EF" in c.upper()][0]
nband_col_l1 = [c for c in df_l1.columns if "BAND" in c.upper()][0]

def calc_n_band(EF, T, c):
    E = np.linspace(0.0, EMAX, 20001)
    return NA * np.trapezoid(c * E * fermi(E, EF, T), E)

def calc_n_fermi(EF, T, c):
    E = np.linspace(EF, EMAX, 20001)
    return NA * np.trapezoid(c * E * fermi(E, EF, T), E)

# 工作点计算 (精确在 EF_op，不使用就近网格)
n_band_op = calc_n_band(EF_op, T_L1, c_DoS)
n_fermi_op = calc_n_fermi(EF_op, T_L1, c_DoS)
correction_factor_op = n_band_op / n_fermi_op
mu_corrected = 1.0 / (E_CHARGE * n_fermi_op * rho_op)

print(f"L1 工作点 EF_op = {EF_op:.4f} eV | 温度 T = {T_L1} K")
print(f"L1 修正系数 C(EF_op) = {correction_factor_op:.5f}")
print(f"L1 修正载流子浓度 n_F = {n_fermi_op:.5e} cm^-2")
print(f"L1 修正后迁移率 mu = {mu_corrected:.2f} cm^2/(V*s)")

