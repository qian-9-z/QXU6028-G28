# 5. PHASE L3: 二维空间反演与晶圆均匀性决断
# ==============================================================================
print("\n" + "-"*50)
print(">>> [Phase L3] 正在执行二维空间反演与均匀性判定...")
print("-"*50)

A = np.load(DATA_DIR / "L3_A.npy")
d_reps = np.loadtxt(DATA_DIR / "L3_d.csv", delimiter=",")

assert A.shape == (128, 100), "A 矩阵形状必须为 (128, 100)"
assert d_reps.shape == (3, 128), "测量数据形状必须为 (3, 128)"
assert np.max(np.abs(A.sum(axis=1))) < 1e-10, "A 矩阵的每行和必须为 0"

dbar = d_reps.mean(axis=0)
sigma_d = d_reps.std(axis=0, ddof=1)

npix = 10
N = npix * npix
coords = np.linspace(-2.7, 2.7, npix)

def gradient_matrix(npix=10):
    rows = []
    N = npix * npix
    for i in range(npix):
        for j in range(npix):
            k = i * npix + j
            if j < npix - 1:
                r = np.zeros(N); r[k] = -1.0; r[k + 1] = 1.0; rows.append(r)
            if i < npix - 1:
                r = np.zeros(N); r[k] = -1.0; r[k + npix] = 1.0; rows.append(r)
    return np.asarray(rows)

L = gradient_matrix(npix)
one = np.ones((N, 1)) / np.sqrt(N)
P = np.eye(N) - one @ one.T
eta0 = 1e-2 * (np.linalg.norm(A, 2)**2) / (np.linalg.norm(L, 2)**2)

def reconstruct(dvec, eta=eta0):
    M = P @ (A.T @ A + eta * (L.T @ L)) @ P + 1e-9 * np.eye(N)
    b = P @ (A.T @ dvec)
    m = np.linalg.lstsq(M, b, rcond=None)[0]
    return m - m.mean()

m_hat_flat = reconstruct(dbar, eta=eta0)
m_hat = m_hat_flat.reshape(npix, npix)

# 合并特征提取 (笛卡尔系：j 对应 x, i 对应 y)
pos_i, pos_j = np.unravel_index(np.argmax(m_hat), (npix, npix))
neg_i, neg_j = np.unravel_index(np.argmin(m_hat), (npix, npix))

features = [
    {
        "type": "positive",
        "pixel_ij": [int(pos_i), int(pos_j)],
        "x_pitch": round(float(coords[pos_j]), 2),
        "y_pitch": round(float(coords[pos_i]), 2),
        "amplitude": round(float(m_hat[pos_i, pos_j]), 4)
    },
    {
        "type": "negative",
        "pixel_ij": [int(neg_i), int(neg_j)],
        "x_pitch": round(float(coords[neg_j]), 2),
        "y_pitch": round(float(coords[neg_i]), 2),
        "amplitude": round(float(m_hat[neg_i, neg_j]), 4)
    }
]

# 分辨率 FWHM (PSF 正瓣加权二次矩)
def get_psf_fwhm(test_i, test_j):
    q = np.zeros(N)
    q[test_i * npix + test_j] = 1.0
    q = q - q.mean()
    q_hat = reconstruct(A @ q, eta=eta0).reshape(npix, npix)
    w = np.maximum(q_hat, 0.0)
    X, Y = np.meshgrid(coords, coords)
    x0, y0 = coords[test_j], coords[test_i]
    sigma2 = np.sum(w * ((X - x0)**2 + (Y - y0)**2)) / (2.0 * np.sum(w))
    return 2.355 * np.sqrt(sigma2)

fwhm_c = get_psf_fwhm(5, 5)
fwhm_e = get_psf_fwhm(2, 7)
conservative_fwhm = round(float(max(fwhm_c, fwhm_e)), 3)

# 噪声极限 delta_95 (500 次 Monte Carlo)
noise_max = []
for _ in range(500):
    n_vec = np.random.normal(0.0, sigma_d, size=128)
    noise_max.append(np.max(np.abs(reconstruct(n_vec, eta=eta0))))
delta_95 = round(float(np.percentile(noise_max, 95)), 4)

max_amp = round(float(np.max(np.abs(m_hat_flat))), 4)
SPEC_THRESHOLD = 0.25

if max_amp + delta_95 < SPEC_THRESHOLD:
    decision = "pass"
    confidence = "clear pass: peak + delta_95 is strictly below threshold"
elif max_amp - delta_95 > SPEC_THRESHOLD:
    decision = "fail"
    confidence = "clear fail: peak - delta_95 is strictly above threshold"
else:
    decision = "borderline"
    confidence = "borderline: threshold lies within noise uncertainty band"

print(f"L3 正则化参数 eta0 = {eta0:.4e}")
print(f"L3 最大不均匀幅值 |m|_max = {max_amp:.4f}")
print(f"L3 95% 噪声检测限 delta_95 = {delta_95:.4f}")
print(f"L3 空间分辨率 = {conservative_fwhm:.3f} probe pitches")
print(f"L3 晶圆判决结果 = {decision} ({confidence})")

