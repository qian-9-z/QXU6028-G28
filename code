                    d[k] = "G28"
                elif k == "dataset_set":
                    d[k] = "blind"
                elif k == "pipeline_commit":
                    d[k] = commit_hash
        return d
    
    final_json_data = fill_tpl(tpl)
else:
    final_json_data = results_payload

