# 4. PHASE L2: 零维反演与能带态密度决策
# ==============================================================================
print("\n" + "-"*50)
print(">>> [Phase L2] 正在执行零维光谱反演与态密度判决...")
print("-"*50)

df_l2 = pd.read_csv(DATA_DIR / "L2_data.csv")
with open(DATA_DIR / "L2_meta.json", "r", encoding="utf-8") as f:
    l2_meta = json.load(f)

T_L2 = float(l2_meta.get("T", l2_meta.get("temperature_K", T_L1)))
kBT = KB * T_L2

# 鲁棒识别测量通道与索引
rh_col, rs_col, idx_col = None, None, None
for c in df_l2.columns:
    clean = c.upper().replace("_", "").replace(" ", "")
    if "INDEX" in clean:
        idx_col = c
    elif "RH" in clean or "HALL" in clean:
        rh_col = c
    elif any(k in clean for k in ["RXX", "RS", "SHEET", "RESIST"]):
        rs_col = c

# 严格保留原始测量顺序提取均值
unique_indices = []
for val in df_l2[idx_col]:
    if val not in unique_indices:
        unique_indices.append(val)

mean_RH = np.array([df_l2[df_l2[idx_col] == i][rh_col].mean() for i in unique_indices])
mean_Rs = np.array([df_l2[df_l2[idx_col] == i][rs_col].mean() for i in unique_indices])

# 独立归一化 (保留 RH 正负号)
RH_data_norm = mean_RH / np.max(np.abs(mean_RH))
Rs_data_norm = mean_Rs / np.max(mean_Rs)
data_xy = np.column_stack([RH_data_norm, Rs_data_norm])

E_grid_L2 = np.linspace(-2.5, 2.5, 4000)
candidate_EF = np.linspace(-8.0 * kBT, 9.0 * kBT, 400)
candidate_Eg_kT = np.arange(0.50, 8.25, 0.25)

def get_dos(E, model, Eg=0.0):
    if model == "cone":
        return c_DoS * np.abs(E)
    delta = Eg / 2.0
    return np.where(np.abs(E) > delta, c_DoS * (np.abs(E) - delta), 0.0)

def simulate_transport(model, Eg=0.0):
    g = get_dos(E_grid_L2, model, Eg)
    RH_mod, Rs_mod = [], []
    for ef in candidate_EF:
        f = fermi(E_grid_L2, ef, T_L2)
        n = NA * np.trapezoid(np.where(E_grid_L2 > ef, g * f, 0.0), E_grid_L2)
        p = NA * np.trapezoid(np.where(E_grid_L2 <= ef, g * (1.0 - f), 0.0), E_grid_L2)
        RH_mod.append((p - n) / ((p + n)**2 + 1e-30))
        Rs_mod.append(1.0 / (p + n + 1e-30))
    RH_m, Rs_m = np.array(RH_mod), np.array(Rs_mod)
    return RH_m / np.max(np.abs(RH_m)), Rs_m / np.max(Rs_m)

def fit_to_curve(model_xy, d_xy):
    d2 = ((d_xy[:, None, :] - model_xy[None, :, :])**2).sum(axis=2)
    j_nearest = np.argmin(d2, axis=1)
    rms = np.sqrt(np.mean(np.min(d2, axis=1)))
    return rms, j_nearest

# 拟合圆锥模型与有隙模型
xy_cone = np.column_stack(simulate_transport("cone"))
r_cone, j_cone = fit_to_curve(xy_cone, data_xy)

best_r_gap, best_Eg_kT, best_j_gap = 1e9, 0.0, None
gap_lib = {}
for eg in candidate_Eg_kT:
    xy_g = np.column_stack(simulate_transport("gap", eg * kBT))
    gap_lib[eg] = xy_g
    rg, jg = fit_to_curve(xy_g, data_xy)
    if rg < best_r_gap:
        best_r_gap, best_Eg_kT, best_j_gap = rg, eg, jg

# 15% 门限模型决断规则
if (best_r_gap < 0.85 * r_cone) and (best_Eg_kT >= 1.0):
    selected_model = "hard_gap"
    final_Eg_kT = float(best_Eg_kT)
    final_j = best_j_gap
else:
    selected_model = "cone"
    final_Eg_kT = 0.0
    final_j = j_cone

EF_trajectory = candidate_EF[final_j].tolist()

# Bootstrap 200 次采样计算 Eg 不确定度
np.random.seed(42)
boot_Eg = []
for _ in range(200):
    s_df = df_l2.groupby(idx_col).sample(n=1, replace=True)
    rh_b = np.array([s_df[s_df[idx_col] == i][rh_col].values[0] for i in unique_indices])
    rs_b = np.array([s_df[s_df[idx_col] == i][rs_col].values[0] for i in unique_indices])
    b_xy = np.column_stack([rh_b / np.max(np.abs(rh_b)), rs_b / np.max(rs_b)])
    
    rc_b, _ = fit_to_curve(xy_cone, b_xy)
    rg_min_b, eg_min_b = 1e9, 0.0
    for eg, g_xy in gap_lib.items():
        rg_b, _ = fit_to_curve(g_xy, b_xy)
        if rg_b < rg_min_b:
            rg_min_b, eg_min_b = rg_b, eg
    boot_Eg.append(eg_min_b if (rg_min_b < 0.85 * rc_b and eg_min_b >= 1.0) else 0.0)

Eg_uncertainty = float((np.percentile(boot_Eg, 84) - np.percentile(boot_Eg, 16)) / 2.0)

print(f"L2 模型选择: {selected_model} (残差比 r_gap/r_cone = {best_r_gap/r_cone:.4f})")
print(f"L2 能隙 Eg = {final_Eg_kT:.2f} kBT | 不确定度 = ±{Eg_uncertainty:.2f} kBT")
print(f"L2 费米能级轨迹点数 = {len(EF_trajectory)} (严格等于唯一索引数 {len(unique_indices)})")

