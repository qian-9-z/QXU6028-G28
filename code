    "model": selected_model,
    "Eg_kT": round(final_Eg_kT, 2),
    "Eg_uncertainty_kT": round(Eg_uncertainty, 2),
    "EF_trajectory_eV": [round(float(x), 5) for x in EF_trajectory],
    "eta": float(eta0),
